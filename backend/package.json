{
  "name": "sweety-backend",
  "version": "1.0.0",
  "description": "Backend API for Sweety – Blood Glucose Tracker with Neon PostgreSQL",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
